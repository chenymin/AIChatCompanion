{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "课程：单次聊天",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file-if-exists=.env"],
      "program": "${workspaceFolder}/src/cli.ts",
      "args": ["突然降温"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "课程：Node Attach",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
