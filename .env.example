# Default: local deterministic mock, no key or network needed.
MODEL_MODE=mock
# Optional deliberate failure: MOCK_FAULT=error
MOCK_FAULT=

# Optional live mode: change MODEL_MODE to live and fill these locally.
# Supply an API root, not the full /chat/completions URL.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
